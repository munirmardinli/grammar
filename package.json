{
  "name": "vscode-spell-grammar-checker",
  "publisher": "munirmardinli",
  "displayName": "Spell & Grammar Checker",
  "description": "VS Code extension for spelling and grammar checking powered by LanguageTool",
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "author": {
    "name": "Munir Mardinli",
    "url": "https://munir.mardinli.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/munirmardinli/grammar-checker"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "main": "./out/index.js",
  "activationEvents": [
    "onLanguage:plaintext",
    "onLanguage:markdown",
    "onLanguage:git-commit"
  ],
  "contributes": {
    "languages": []
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0"
  }
}
