{
  "name": "vscode-spell-grammar-checker",
  "publisher": "munirmardinli",
  "displayName": "Spell & Grammar Checker",
  "description": "VS Code extension for spelling and grammar checking powered by LanguageTool",
  "icon": "images/icon.png",
  "version": "1.0.1",
  "license": "MIT",
  "author": {
    "name": "Munir Mardinli",
    "url": "https://munir.mardinli.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/munirmardinli/grammar"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:plaintext",
    "onLanguage:markdown",
    "onLanguage:git-commit"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run compile:extension",
    "compile:extension": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --sourcemap",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --sourcemap --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --minify",
    "vsix": "npx --yes @vscode/vsce package --no-dependencies --out ./vscode-spell-grammar-checker.vsix",
    "install:vsix": "npm run vsix && code --install-extension ./vscode-spell-grammar-checker.vsix",
    "watch-tests": "tsc -p . -w --outDir out",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
  "@types/vscode": "^1.80.0",
  "@types/mocha": "^10.0.10",
  "@types/node": "24.x",
  "esbuild": "^0.28.1",
  "npm-run-all": "^4.1.5",
  "typescript": "^6.0.3"
  },
  "dependencies": {
    "axios": "^1.13.2"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
